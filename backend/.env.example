# Copy to .env and fill values; DO NOT commit .env to git
# Example for Supabase (session pooler/direct connection)

# Recommended: set DATABASE_URL (will be parsed by dj-database-url)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres.yvwckxixixidsgqtwupc:your-password-here@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Alternatively, set individual variables
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.yvwckxixixidsgqtwupc
DB_PASSWORD=your-password-here
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=5432

# Django settings
SECRET_KEY= your-secret-key-here
DEBUG=False

# Optional: Supabase project URL (useful for SDKs)
SUPABASE_URL=https://yvwckxixixidsgqtwupc.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-service-key
